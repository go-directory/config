dn: cn=dib,cn=config
objectClass: top
objectClass: goDirConfigDIB
cn: dib

# note: configDITSuffix MUST be a zero
# (empty) value, as frontend holds the
# rootDSE.
dn: cn=frontend,cn=dib,cn=config
objectClass: top
objectClass: goDirConfigDIT
cn: frontend
configDITType: 1
configDataFileMode: 0444
configDITSuffix:
configDITName: frontend

dn: cn=schema,cn=dib,cn=config
objectClass: top
objectClass: goDirConfigDIT
cn: schema
configDITType: 1
configDataFileMode: 0664
configDITSuffix: cn=schema
configDITName: schema

dn: cn=meta-schema,cn=dib,cn=config
objectClass: top
objectClass: goDirConfigDIT
cn: meta-schema
configDITType: 1
configDataFileMode: 0444
configDITSuffix: ou=schema
configDITName: meta-schema
configSubordinatesPolicy: 1

dn: cn=config,cn=dib,cn=config
objectClass: top
objectClass: goDirConfigDIT
cn: config
configDITType: 1
configDataFileMode: 0660
configDITSuffix: cn=config
configDITName: config

dn: cn=state,cn=dib,cn=config
objectClass: top
objectClass: goDirConfigDIT
cn: state
configDITType: 1
configDataFileMode: 0660
configDITSuffix: cn=state
configDITName: state

dn: cn=example,cn=dib,cn=config
objectClass: top
objectClass: goDirConfigDIT
cn: example
configDITType: 2
configDBNoSync: TRUE
configDataFileMode: 0660
configDITSuffix: dc=example,dc=com
configDITName: example
configDataDir: /path/to/go-directory/var/data
configSubordinatesPolicy: 3

dn: cn=chaining,cn=example,cn=dib,cn=config
objectClass: top
objectClass: goDirConfigChains
cn: chaining

dn: cn=authority,cn=chaining,cn=example,cn=dib,cn=config
objectClass: top
objectClass: goDirConfigChain
description: chain writes to master
cn: authority
configChainingEndpointURI: ldap://endpoint.local:10389
configChainingSASLMechanism: EXTERNAL
configTLSClientCert: /path/to/go-directory/etc/tls/client-cert.pem
configTLSClientKey: /path/to/go-directory/etc/tls/client-priv.key
configTLSClientMutual: TRUE

dn: cn=sync,cn=example,cn=dib,cn=config
objectClass: top
objectClass: goDirConfigReplAgreements
cn: sync

dn: cn=source,cn=sync,cn=example,cn=dib,cn=config
objectClass: top
objectClass: goDirConfigReplAgreement
description: standard pull from upstream provider
cn: source
configReplAgreementBaseDN: dc=example,dc=com
configReplAgreementProviderURI: ldap://someprovider.local
configReplAgreementSASLMechanism: EXTERNAL
configReplAgreementSearchScope: sub
configReplAgreementSearchFilter: (objectClass=*)
configReplAgreementUseTxLog: TRUE
configReplAgreementAttribute: cn
configReplAgreementAttribute: objectClass
configReplAgreementAttribute: telephoneNumber
configReplAgreementAttribute: givenName
configReplAgreementAttribute: sn
configReplAgreementAttribute: l
configReplAgreementAttribute: st
configReplAgreementAttribute: c
configTLSClientCert: /path/to/go-directory/etc/tls/client-cert.pem
configTLSClientKey: /path/to/go-directory/etc/tls/client-priv.key
configTLSClientMutual: TRUE

dn: cn=limits,cn=example,cn=dib,cn=config
objectClass: top
objectClass: goDirConfigLimits
cn: limits
configSizeLimit: 750

dn: cn=indices,cn=example,cn=dib,cn=config
objectClass: top
objectClass: goDirConfigIndices
cn: indices

dn: cn=mail,cn=indices,cn=example,cn=dib,cn=config
objectClass: top
objectClass: goDirConfigIndex
cn: mail
configIndexEquality: TRUE
configIndexSubstring: TRUE
configIndexPresence: TRUE

dn: cn=people,cn=dib,cn=config
objectClass: top
objectClass: goDirConfigDIT
cn: people
configDITType: 2
configDataFileMode: 0660
configDBNoSync: TRUE
configDataDir: /path/to/go-directory/var/data
configDITSuffix: ou=People,dc=example,dc=com
configGlueParentSuffix: dc=example,dc=com
configSubordinatesPolicy: 2

dn: cn=tls,cn=people,cn=dib,cn=config
objectClass: top
objectClass: goDirConfigTLS
cn: tls
description: Client TLS
configTLSClientCert: /path/to/go-directory/etc/tls/client-cert.pem
configTLSClientKey: /path/to/go-directory/etc/tls/client-priv.key
configTLSClientMutual: TRUE

