configReplAgreementProviderURI: ldap://someprovider.local
configReplAgreementSASLMechanism: EXTERNAL
configReplAgreementSearchScope: sub
configReplAgreementSearchFilter: (objectClass=*)
configReplAgreementUseTxLog: TRUE
configReplAgreementAttribute: cn
configReplAgreementAttribute: objectClass
